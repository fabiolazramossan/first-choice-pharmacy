NEXT_PUBLIC_SITE_URL=https://first-choice-pharmacy.vercel.app
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only values. Never prefix these with NEXT_PUBLIC_.
RESEND_API_KEY=re_your_key
PHARMACY_EMAIL=orders@example.com
REFILL_FROM_EMAIL=First Choice Pharmacy <refills@your-domain.com>
ORDER_FROM_EMAIL=First Choice Pharmacy <orders@your-domain.com>

# Server-only Supabase secret key (sb_secret_...). Used ONLY by /api/orders to
# call the create_order() database function. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Online ordering is closed unless this is exactly "true".
ORDERS_ENABLED=false

# Customer order confirmation emails. Off unless exactly "true".
CUSTOMER_EMAILS_ENABLED=false

# Pricing (server-only). Leave EMPTY until the pharmacy/accountant confirms
# them; unset values are shown to customers as "a confirmar".
# IVU_RATE is a fraction (e.g. 0.07 means 7%), not a percentage.
IVU_RATE=
DELIVERY_FEE=
FREE_DELIVERY_THRESHOLD=
